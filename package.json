{
  "name": "anylumino-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs",
    "build": "node scripts/build-frontend.mjs",
    "test": "node --test tests/frontend/*.test.mjs",
    "licenses": "node scripts/generate-frontend-licenses.mjs",
    "docs:convert": "node scripts/generate-api-docs.mjs",
    "docs:build": "next build",
    "docs:dev": "next dev",
    "docs:lint": "eslint app docs-site scripts/generate-api-docs.mjs tests/docs-href.test.mjs next.config.mjs postcss.config.mjs",
    "docs:types": "next typegen && tsc --noEmit",
    "docs:test-links": "node --test tests/docs-href.test.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@lumino/commands": "2.3.4",
    "@lumino/widgets": "2.9.0",
    "fumadocs-core": "16.15.11",
    "fumadocs-mdx": "15.4.1",
    "fumadocs-python": "1.0.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.11",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@astryxdesign/cli@0.6.2": true,
    "@astryxdesign/core@0.6.2": true,
    "unrs-resolver@1.12.2": false
  }
}
