{
  "name": "anylumino-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs",
    "build": "node scripts/build-frontend.mjs",
    "test": "node --test tests/frontend/*.test.mjs",
    "licenses": "node scripts/generate-frontend-licenses.mjs",
    "docs:convert": "node scripts/generate-api-docs.mjs",
    "docs:build": "next build",
    "docs:dev": "next dev",
    "docs:lint": "eslint app docs-site scripts/generate-api-docs.mjs tests/docs-href.test.mjs next.config.mjs postcss.config.mjs",
    "docs:types": "next typegen && tsc --noEmit",
    "docs:test-links": "node --test tests/docs-href.test.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.1",
    "@astryxdesign/richtext": "^0.7.1",
    "@astryxdesign/theme-butter": "^0.7.1",
    "@astryxdesign/theme-chocolate": "^0.7.1",
    "@astryxdesign/theme-gothic": "^0.7.1",
    "@astryxdesign/theme-matcha": "^0.7.1",
    "@astryxdesign/theme-neutral": "^0.7.1",
    "@astryxdesign/theme-stone": "^0.7.1",
    "@astryxdesign/theme-y2k": "^0.7.1",
    "@lexical/code": "0.52.0",
    "@lexical/extension": "0.52.0",
    "@lexical/headless": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@lumino/commands": "2.3.4",
    "@lumino/widgets": "2.10.0",
    "@openuidev/lang-core": "1.0.1",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-python": "1.0.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "lexical": "0.52.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@astryxdesign/cli@0.7.1": true,
    "@astryxdesign/core@0.7.1": true,
    "unrs-resolver@1.12.2": false,
    "@openuidev/lang-core@1.0.1": false
  }
